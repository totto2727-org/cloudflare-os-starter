{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "vp run -r --cache build",
    "test": "node --test 'scripts/**/*.test.ts' && vp run --filter '!cloudflare-os-starter' --cache test",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "oxlint --config .oxlintrc.mjs --deny-warnings",
    "lint:fix": "oxlint --config .oxlintrc.mjs --deny-warnings --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check": "node scripts/deploy.ts --check",
    "deploy": "node scripts/deploy.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@totto2727/gitignore-patterns": "^0.1.0",
    "@totto2727/oxlint": "^0.1.0",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
